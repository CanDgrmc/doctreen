{
  "openapi": "3.1.0",
  "info": {
    "title": "Secured",
    "version": "1.2.0"
  },
  "servers": [
    {
      "url": "https://api.example.com",
      "description": "Production"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "get_me",
        "tags": [
          "me"
        ],
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "uuid v4",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          }
        },
        "summary": "Inherits the global bearerAuth requirement"
      }
    },
    "/health": {
      "get": {
        "operationId": "get_health",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        },
        "summary": "Explicitly public — overrides the global default",
        "security": []
      }
    },
    "/webhooks/replay": {
      "post": {
        "operationId": "post_webhooks_replay",
        "tags": [
          "webhooks"
        ],
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "queued": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "queued"
                  ]
                }
              }
            }
          }
        },
        "summary": "Requires the API-key scheme instead",
        "security": [
          {
            "apiKey": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "me"
    },
    {
      "name": "health"
    },
    {
      "name": "webhooks"
    }
  ]
}
